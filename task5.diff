+    def _new_evidence_record(self, detector, score=0, reason=None, layer="raw",
+                             coverage="full", truncated=False, status="clean",
+                             rule_version=None, model_version=None):
+        return make_evidence(
+            detector=detector, score=score, reason=reason, layer=layer,
+            coverage=coverage, truncated=truncated, status=status,
+            rule_version=rule_version, model_version=model_version,
+        )
+
+    def _finalize_candidate_evidence(self, evidence, legacy_score=0,
+                                     legacy_decision=None, coverage="full",
+                                     status="complete", min_score=None,
+                                     gray_min=None):
+        records = list(evidence or [])
+        groups = {record.get("detector") for record in records if int(record.get("score", 0)) > 0}
+        behavioral_scores = {
+            record.get("detector"): int(record.get("score", 0))
+            for record in records
+            if record.get("detector") in {"source_sink", "behavior_graph", "webshell_capability", "ast_df"}
+        }
+        min_score = self._get_min_score(None) if min_score is None else int(min_score)
+        gray_min = self._get_gray_zone_min() if gray_min is None else int(gray_min)
+        legacy_score = int(legacy_score)
+        shadow_score = legacy_score
+        if self.effective_policy.get("behavioral_fusion_enabled", False):
+            shadow_score = max(shadow_score, fuse_behavioral_scores(
+                behavioral_scores,
+                float(self.effective_policy.get("behavioral_corroboration_ratio", 0.25)),
+                int(self.effective_policy.get("behavioral_fusion_cap", 100)),
+            ))
+        if legacy_decision is None:
+            legacy_decision = (
+                "finding" if legacy_score >= min_score else
+                "gray_zone" if legacy_score >= gray_min else "clean"
+            )
+        shadow_decision = (
+            "finding" if shadow_score >= min_score else
+            "gray_zone" if shadow_score >= gray_min else "clean"
+        )
+        primary = max(records, key=lambda item: int(item.get("score", 0)), default=None)
+        if any(record.get("status") not in (None, "clean") for record in records):
+            status = status if status != "complete" else "partial"
+        if coverage != "full" and status == "complete":
+            status = "partial"
+        return {
+            "legacy_score": legacy_score,
+            "shadow_score": shadow_score,
+            "evidence_groups": sorted(group for group in groups if group),
+            "primary_evidence": primary,
+            "legacy_decision": legacy_decision,
+            "shadow_decision": shadow_decision,
+            "status": status,
+            "coverage": coverage,
+            "evidence": records,
+            "decision_reason": decision_reason(
+                groups, legacy_score, min_score, gray_min,
+                yara_timeout=any(record.get("status") == "timeout" for record in records),
+                coverage=coverage,
+            ),
+        }
+
+    @staticmethod
+    def _sha256_path(path):
+        digest = hashlib.sha256()
+        with open(path, "rb") as handle:
+            for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+                digest.update(chunk)
+        return digest.hexdigest()
+
+    def _archive_benchmark_metadata(self, archive_path, member_path, member_data,
+                                    archive_chain=()):
+        member_path = os.path.normpath(str(member_path or "")).replace("\\", "/")
+        if member_path == "." or member_path.startswith("../") or member_path.startswith("/"):
+            raise ValueError("unsafe archive member path")
+        archive_sha256 = self._sha256_path(archive_path)
+        member_sha256 = hashlib.sha256(member_data).hexdigest()
+        chain = tuple(str(item).replace("\\", "/") for item in (archive_chain or ()))
+        return {
+            "archive_sha256": archive_sha256,
+            "member_path": member_path,
+            "member_sha256": member_sha256,
+            "archive_chain": list(chain),
+            "candidate_id": canonical_candidate_id(
+                getattr(self, "run_id", ""), member_sha256, member_path,
+                archive_sha256=archive_sha256, archive_chain=chain,
+                member_path=member_path, member_sha256=member_sha256,
+            ),
+        }
